{
  "version": 1,
  "onboarding": {
    "firstRun": {
      "development": "off",
      "production": "connect"
    }
  },
  "doctor": {
    "failOnBuild": false
  },
  "apps": {
    "content": {
      "roots": [
        {
          "name": "Sundrift Journal",
          "path": "journal",
          "kind": "docs",
          "extensions": [".md", ".mdx"],
          "source": {
            "type": "local-folder",
            "connectionId": "sundrift-journal",
            "truthPolicy": "source_primary"
          }
        }
      ]
    }
  }
}

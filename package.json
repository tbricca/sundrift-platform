{
  "name": "sundrift-platform",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "WORKSPACE_PORT=${WORKSPACE_PORT:-8080} agent-native dev",
    "build": "pnpm -r build",
    "prebuild": "agent-native doctor --strict",
    "doctor": "agent-native doctor",
    "agent-native:doctor": "agent-native doctor",
    "typecheck": "pnpm -r typecheck",
    "repair:workspace-org": "tsx scripts/repair-workspace-org.ts",
    "skills:update": "agent-native skills update scaffold --project",
    "upgrade:agent-native": "agent-native upgrade",
    "fmt:check": "oxfmt --check .",
    "lint": "pnpm fmt:check",
    "postinstall": "pnpm --filter ./packages/scheduling build && pnpm --filter ./packages/creative-context build && pnpm --filter ./packages/embedding build"
  },
  "dependencies": {
    "@agent-native/core": "0.202.0",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "oxfmt": "catalog:",
    "tsx": "catalog:",
    "typescript-7": "catalog:"
  },
  "packageManager": "pnpm@10.29.1",
  "agent-native": {
    "workspaceCore": "@sundrift/shared"
  }
}
